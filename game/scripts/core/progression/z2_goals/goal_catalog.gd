static func definitions(kind: String = "") -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for group in [["main", MAIN], ["side", SIDE], ["achievement", ACHIEVEMENTS]]:
		if not kind.is_empty() and kind != group[0]:
			continue
		for index in range(group[1].size()):
			result.append(_definition(group[0], group[1][index], index + 6))
	return result


static func definition(id: String) -> Dictionary:
	if id.length() != 3:
		return {}
	var index := id.substr(1).to_int() - 1
	for group in [["M", "main", MAIN], ["S", "side", SIDE], ["A", "achievement", ACHIEVEMENTS]]:
		if id.begins_with(group[0]) and index >= 0 and index < group[2].size() and group[2][index][0] == id:
			return _definition(group[1], group[2][index], index + 6)
	return {}


static func _definition(kind: String, row: Array, source_row: int) -> Dictionary:
	var milestones: Array[Dictionary] = []
	for index in range(row[4].size()):
		milestones.append({"tier": index + 1, "target": row[4][index], "reward": {"exp": row[5], "gold": row[6][index]}})
	return {
		"id": row[0], "kind": kind, "display_name": row[1], "condition": row[2],
		"required_main": row[3], "requires_opening_batch_one": row[0] == "S04",
		"milestones": milestones, "source_id": "S6", "source_row": source_row,
	}
